# ─────────────────────────────────────────────────────────────────────────────
# Vellum — environment template
#
# Copy this file to `.env.local` and fill in whichever providers you want to
# use. `.env.local` is gitignored; never commit real credentials.
#
# These files are loaded into process.env by src/main/env.ts when the app
# starts (electron-vite only forwards VITE_*-prefixed vars, and these keys are
# deliberately unprefixed). Real environment variables always win over the
# file. In a packaged build the `.env*` files are not shipped, so set keys in
# the app's Settings dialog instead.
#
# All providers below speak the OpenAI chat-completions protocol and are wired
# up through @ai-sdk/openai-compatible. At startup the app picks the first
# provider below that has a key AND a curated free model, so setting just
# GROQ_API_KEY is enough to start on a free tier.
#
# You can also set keys in the app's Settings dialog instead; those are
# encrypted with Electron safeStorage and take priority over the environment.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Free / free-tier coding providers (checked in this order) ───────────────

# Groq — very fast open-weight inference. Free tier is rate limited.
# Free models: openai/gpt-oss-120b, openai/gpt-oss-20b
GROQ_API_KEY=

# OpenRouter — one key, hundreds of models. Models ending in `:free` cost
# nothing (~20 req/min, 200 req/day).
# Free models: qwen/qwen3.8-27b:free, z-ai/glm-5.2:free, …
OPENROUTER_API_KEY=

# Google Gemini — Flash models are on the free tier.
# Free models: gemini-3.8-flash, gemini-3.1-flash-lite, gemini-2.5-flash
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# NVIDIA NIM — hosted open-weight models with free credits, low rate limit.
# Free models: moonshotai/kimi-k2.6, z-ai/glm-5.2, openai/gpt-oss-120b
NVIDIA_API_KEY=
NVIDIA_NIM_API_KEY=

# Cohere — trial keys are free but rate limited and not for production.
# Model ids change often, so the app loads them live from /models.
COHERE_API_KEY=

# ─── Multi-provider gateway / paid providers ────────────────────────────────

# Vercel AI Gateway — one key for many providers (billed per token)
AI_GATEWAY_API_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Local models ────────────────────────────────────────────────────────────
# Ollama needs no key, only a running server. Free and fully offline.
OLLAMA_BASE_URL=http://localhost:11434/v1

# ─── Web research ──────────────────────────────────────────────────────────
# Brave Search API powers source discovery for deep research. Free tier:
# 1 query/second, 2,000 queries/month. Get a key at brave.com/search/api.
# You can also set this in the app's Settings dialog (encrypted on disk).
BRAVE_API_KEY=

# ─── External services ─────────────────────────────────────────────────────
# Optional. Each powers a specific capability and can also be set in the app's
# Settings dialog (encrypted with OS-level storage), which takes priority over
# the environment. Providing any *one* search key is enough for advancedSearch
# to work — the agent picks the first configured provider.

# Web search
TAVILY_API_KEY=
EXA_API_KEY=
# Optional second Exa key, used when the first is rate limited.
EXA_API_KEY_2=
SERPER_API_KEY=

# Scraping (renders JavaScript-heavy pages to markdown)
FIRECRAWL_API_KEY=

# Documentation lookup (version-specific library docs + code snippets)
CONTEXT7_API_KEY=

# Images (stock photography for notebooks). Search only needs the access key.
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# Speech
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# ─── RAG / embeddings ────────────────────────────────────────────────────────
# Optional. RAG needs a provider that actually serves an *embeddings* endpoint;
# most free chat tiers (Groq, OpenRouter :free) do not, so this is configured
# separately from the chat provider. Set BOTH values or RAG stays disabled.
#
#   EMBEDDING_PROVIDER=nvidia  EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
#   EMBEDDING_PROVIDER=gemini  EMBEDDING_MODEL=text-embedding-004
#
# EMBEDDING_DIM must match the chosen model (text-embedding-3-small => 1536).
# Changing it after indexing requires re-indexing: the vec0 table is created
# with a fixed dimension.
EMBEDDING_DIM=1536
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
# Renderer dev-server port for `npm start`
PORT=1212
