{
  "compilerOptions": {
    "incremental": true,
    "target": "es2022",
    "module": "nodenext",
    "lib": ["dom", "es2022"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "outDir": ".erb/dll",
    "rootDir": ".",
    "types": ["node", "jest"]
  },
  "exclude": [
    "test",
    // Disconnected legacy prototype; its stale tests are not part of the app typecheck.
    "src/__tests__/motion-pipeline-*.test.ts",
    "src/lib/motion/pipeline",
    "release/build",
    "release/app/dist",
    ".erb/dll",
    "node_modules",
    ".erb/tooling/node_modules"
  ],
  "include": [
    "src",
    "scripts",
    ".erb/configs",
    ".erb/scripts",
    "eslint.config.js",
    "jest.config.js",
    "assets",
    "electron.vite.config.ts"
  ]
}
