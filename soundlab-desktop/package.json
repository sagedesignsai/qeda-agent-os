{
  "name": "soundlab-desktop",
  "description": "SoundLab — A brainwave entrainment DAW with AI copilot",
  "main": "./release/app/dist/main/main.js",
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=8192' electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir release/app",
    "start": "electron-vite dev --watch",
    "test": "jest",
    "preview": "electron-vite preview"
  },
  "browserslist": [
    "extends browserslist-config-erb"
  ],
  "prettier": {
    "singleQuote": true
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.92",
    "@ai-sdk/openai-compatible": "^3.0.55",
    "@ai-sdk/react": "^4.0.117",
    "ai": "^7.0.114",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.3",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "lucide-react": "^1.47.0",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "browserslist-config-erb": "^0.0.3",
    "electron": "^44.4.0",
    "electron-builder": "^26.15.3",
    "electron-debug": "^4.1.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "productName": "SoundLab",
    "appId": "com.soundlab.desktop",
    "asar": true,
    "asarUnpack": "**\\*.{node,dll}",
    "files": [
      "dist",
      "node_modules",
      "package.json"
    ],
    "directories": {
      "app": "release/app",
      "output": "release/build"
    }
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": ">=1.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "bun",
      "version": ">=1.0.0",
      "onFail": "error"
    }
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "type": "commonjs"
}
